# Run pnpm setup to create a local administrator and .env.local.
APP_URL=http://localhost:3000
STORAGE_DRIVER=local
DATA_DIR=.data
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# On Vercel, use supabase. Never store these values in NEXT_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=notice-files
