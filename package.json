{
  "name": "global-ryukyu-okinawa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "test": "playwright test",
    "test:persistence": "node scripts/test-persistence.mjs",
    "format": "prettier --write .",
    "export:cloudflare": "node scripts/export-cloudflare.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vinext build && node scripts/prepare-static-pages.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.10",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vinext": "1.0.0-beta.10",
    "vite": "^8.3.0",
    "wrangler": "^4.132.0"
  },
  "packageManager": "pnpm@11.19.0",
  "type": "module"
}
